[Unit]
Description=Math on the Edge: read the compute solver's examples into the llama-server cache (one-off after boot)
After=math-compute.service
Wants=math-compute.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO_DIR@
ExecStart=/usr/bin/python3 @REPO_DIR@/board/warm_compute.py
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
